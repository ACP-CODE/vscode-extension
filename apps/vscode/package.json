{
  "name": "extension",
  "displayName": "%displayName%",
  "version": "0.0.1",
  "private": "true",
  "description": "%description%",
  "categories": [
    "Other"
  ],
  "keywords": [
    "extension",
    "vscode"
  ],
  "bugs": {
    "url": "https://github.com/ACP-CODE/vscode-extension/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Cyril",
    "email": "jakichen@live.cn"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ACP-CODE/vscode-extension.git"
  },
  "sponsor": {
    "url": "https://slous.inc/sponsor"
  },
  "publisher": "Solus",
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "vpr compile && vpr docs:update",
    "compile": "rolldown -c rolldown.config.ts",
    "watch": "vpr compile --watch",
    "pretest": "TEST=true vpr compile && vp lint",
    "test": "vp test && vscode-test",
    "test:unit": "TEST_SUITE=unit vscode-test",
    "rolldown": "rolldwon",
    "vsce": "vsce",
    "docs:update": "node scripts/vscode_docs.mts update && vp fmt"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/vscode": "1.105.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "rolldown": "^1.2.6"
  },
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "extension.helloWorld",
        "title": "Hello World"
      }
    ],
    "configuration": {
      "properties": {}
    }
  },
  "engines": {
    "vscode": "^1.105.0"
  }
}
