{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "lib": ["ES2021"],
    "rootDir": ".",
    "outDir": "out",
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": ["node_modules", ".vscode-test", "out"]
}
